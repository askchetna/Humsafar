APP_NAME=Humsafar

# --- Database ---
# Dev (SQLite)
DATABASE_URL=sqlite:///./humsafar.db
# Production (PostgreSQL) — required for commercial deployment
# DATABASE_URL=postgresql+psycopg2://humsafar:password@localhost:5432/humsafar
# Docker Compose sets this automatically via docker-compose.yml

# --- Security ---
JWT_SECRET=change-me-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Redis (enable in production) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- CORS (comma-separated; match your public domain) ---
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Production example:
# CORS_ORIGINS=https://app.yourdomain.com

# --- Dispatch ---
DRIVER_SEARCH_RADIUS_KM=15.0

# --- Rate limiting (per IP) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_RIDE_MAX=20
RATE_LIMIT_RIDE_WINDOW=60

# --- Geocoding ---
GEOCODING_ENABLED=true

# --- Docker Compose (optional; used by docker-compose.yml) ---
# POSTGRES_PASSWORD=changeme
# HTTP_PORT=80
